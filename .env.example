# ════════════════════════════════════════════════════════
# PortfolioQuant - Variables d'environnement
# ════════════════════════════════════════════════════════
# Copie ce fichier vers .env et remplis les valeurs.
# NE COMMIT JAMAIS le .env reel.

# ─── Authentification ─────────────────────────────────
# Mot de passe pour acceder a l'app (obligatoire en prod)
APP_PASSWORD=change_me_to_a_strong_password

# Identifiant (optionnel, sinon mot de passe seul)
APP_USERNAME=admin

# ─── Cles de chiffrement ──────────────────────────────
# Cle Fernet pour chiffrer les credentials brokers stockes (creds.enc).
# Genere une cle avec :  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_base64_fernet_key_here

# Secret pour les sessions Flask (cookies signes).
# Genere avec :  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_64_char_hex_string

# ─── Stockage des donnees (optionnel) ─────────────────
# Repertoire ou stocker les fichiers de donnees utilisateur.
# Par defaut : repertoire courant. Pour Railway, mappe un volume persistant ici.
# DATA_DIR=/data

# ─── Port (auto-defini par Railway/Heroku) ────────────
# PORT=8000
